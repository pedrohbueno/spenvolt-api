alAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2410" y="1560" width="260" height="134" as="geometry"/></mxCell><mxCell id="GoogleShoppingAdapter_a0" value="-baseUrl: String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoogleShoppingAdapter"><mxGeometry y="26" width="260" height="20" as="geometry"/></mxCell><mxCell id="GoogleShoppingAdapter_a1" value="-timeoutMs: Integer" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoogleShoppingAdapter"><mxGeometry y="46" width="260" height="20" as="geometry"/></mxCell><mxCell id="GoogleShoppingAdapter_d" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=inherit;" vertex="1" parent="GoogleShoppingAdapter"><mxGeometry y="66" width="260" height="8" as="geometry"/></mxCell><mxCell id="GoogleShoppingAdapter_m0" value="+search(query: String): List&amp;lt;DeviceOffer&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoogleShoppingAdapter"><mxGeometry y="74" width="260" height="20" as="geometry"/></mxCell><mxCell id="GoogleShoppingAdapter_m1" value="+getSourceName(): String" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoogleShoppingAdapter"><mxGeometry y="94" width="260" height="20" as="geometry"/></mxCell><mxCell id="GoogleShoppingAdapter_m2" value="+isAvailable(): Boolean" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="GoogleShoppingAdapter"><mxGeometry y="114" width="260" height="20" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=block;endSize=14;endFill=0;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="GoogleShoppingAdapter" target="MarketplaceAdapter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Architecture notes&lt;/b&gt;&lt;br&gt;• Layers: Controller → Service → Repository (Spring Data JPA) → Entity. Controllers exchange only Request/Response DTOs. CRUD controllers follow XxxController → XxxService → XxxRepository (omitted).&lt;br&gt;• Persisted tables: users, members, residences, devices, device_members (join table of the Member–Device many-to-many) and consumption_history.&lt;br&gt;• Profile is abstract (@MappedSuperclass): User and Member inherit id, name, email, photoUrl, createdAt.&lt;br&gt;• Device always belongs to a User (owner) and optionally to a Residence. It can be shared by several Members; its cost is split equally among them.&lt;br&gt;• Consumption: kWh/month = (powerW × hoursPerDay × daysPerMonth) / 1000; cost = kWh × Residence.tariffKwh.&lt;br&gt;• Limit and alert are not classes: Residence holds monthlyKwhLimit, monthlyCostLimit and alertThresholdPercent; ConsumptionService.getLimitStatus() computes a LimitStatus DTO (usagePercent, level OK/WARNING/EXCEEDED) on demand.&lt;br&gt;• Report is a DTO built from ConsumptionHistory. DeviceOffer is fetched live from the marketplaces (no table) and a new store means a new adapter only.&lt;br&gt;• Fixed value sets (category, availability, level) are plain Strings in the model; use enums in code if you want, they do not need a box here." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="2060" width="1200" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>